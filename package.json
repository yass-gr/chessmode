{
	"name": "chessmode",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"validate:courses": "for f in src/lib/courses/*.json; do node scripts/validate-course.mjs $f || exit 1; done",
		"cap:sync": "vite build && cap sync",
		"android:run": "npm run cap:sync && cap run android",
		"android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
	},
	"devDependencies": {
		"@capacitor/cli": "8.6.3",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.81.0",
		"@capacitor/android": "8.6.3",
		"@capacitor/app": "8.1.2",
		"@capacitor/browser": "8.0.5",
		"@capacitor/core": "8.6.3",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/ios": "8.6.3",
		"@capacitor/keyboard": "8.0.6",
		"@capacitor/splash-screen": "8.0.2",
		"@capacitor/status-bar": "8.0.4",
		"chess.js": "^1.4.0",
		"chessground": "^9.2.1",
		"dexie": "^4.4.7",
		"stockfish": "^19.0.1",
		"ts-fsrs": "^6.0.1"
	}
}
